# Copy this file to .env and fill in as needed. None of the values below are
# secret in this project (local dev Postgres credentials, public Auth0
# tenant identifiers) -- see README.md for the exact setup steps.

DATABASE_URL="postgresql://johndoe:randompassword@localhost:5433/mydb?schema=public"

# Same container/database, separate schema — keeps e2e test runs from
# wiping data a dev session is relying on. See AI_WORKFLOW.md for why.
DATABASE_URL_TEST="postgresql://johndoe:randompassword@localhost:5433/mydb?schema=test"

# Auth0 tenant used to verify API access tokens (see DECISIONS.md)
AUTH0_ISSUER="https://dev-yg.us.auth0.com/"
AUTH0_AUDIENCE="https://bbl-candidate-test-api"

# Frontend owns port 3000 (fixed Auth0 callback URL registration), so the
# backend runs here instead.
PORT=3001
FRONTEND_ORIGIN="http://localhost:3000"
